PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lexbridge
# At least 32 characters. Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000
# Express "trust proxy" setting. The Next.js app proxies /api to this server.
# Behind a load balancer, set this to the number of proxy hops (e.g. 1) so rate limits see real client IPs.
TRUST_PROXY=loopback
# Comma-separated emails that become admins on sign-in
ADMIN_EMAILS=
# Resend API key. Leave empty in dev to print emails to the console.
RESEND_API_KEY=
MAIL_FROM=LexBridge <no-reply@example.com>
ANTHROPIC_API_KEY=
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Scaling & reliability (see SCALING.md) ---
# MongoDB pool per API process. Total connections = MONGO_MAX_POOL_SIZE x processes; keep under your cluster's limit.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
# Build indexes at boot. Defaults to true outside production; in production run `pnpm db:sync-indexes` on deploy instead.
MONGO_AUTO_INDEX=
# Requests that take longer get a 503 (uploads use UPLOAD_TIMEOUT_MS)
REQUEST_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=120000
# Time allowed to finish in-flight requests on SIGTERM before exiting
SHUTDOWN_TIMEOUT_MS=15000
# Worker processes for `pnpm start:cluster` (default: number of CPU cores)
WEB_CONCURRENCY=

# Document storage: local (development) or s3 (production/shared storage)
STORAGE_DRIVER=local
# Private folder for uploaded documents when STORAGE_DRIVER=local (default: apps/api/uploads)
UPLOAD_DIR=
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO). For R2: S3_REGION=auto, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
# Leave both empty to use the default AWS credential chain (e.g. an IAM role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=documents/

# Notification outbox worker (emails and WhatsApp are queued in MongoDB and retried)
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=2000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_BATCH_SIZE=20

# WhatsApp Cloud API (Meta). Notifications are skipped unless token and phone number ID are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved template names in WhatsApp Manager. Body variables are positional:
#   request_received:        {{1}} name, {{2}} reference, {{3}} service
#   request_status_changed:  {{1}} name, {{2}} reference, {{3}} status
#   consultation_booked:     {{1}} name, {{2}} reference, {{3}} date & time (IST), {{4}} mode
#   consultation_cancelled:  {{1}} name, {{2}} reference, {{3}} date & time (IST)
#   meeting_link_added:      {{1}} name, {{2}} date & time (IST), {{3}} meeting link
WHATSAPP_TEMPLATE_REQUEST_RECEIVED=request_received
WHATSAPP_TEMPLATE_REQUEST_STATUS_CHANGED=request_status_changed
WHATSAPP_TEMPLATE_CONSULTATION_BOOKED=consultation_booked
WHATSAPP_TEMPLATE_CONSULTATION_CANCELLED=consultation_cancelled
WHATSAPP_TEMPLATE_MEETING_LINK_ADDED=meeting_link_added

# --- WhatsApp AI assistant (inbound chat) ---
# Also needs WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID above. The assistant stays off until all four are set.
# Webhook URL to register in the Meta App Dashboard: https://<api-domain>/api/webhooks/whatsapp (subscribe to "messages")
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value into the Meta webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=
# Question plan. packages/shared/src/whatsAppPlan.js holds the same defaults for the website copy; change both together.
WHATSAPP_AI_FREE_MESSAGES=5
WHATSAPP_AI_PACK_MESSAGES=30
WHATSAPP_AI_PACK_PRICE_PAISE=19900
# Claude model and effort (low | medium | high) for replies
WHATSAPP_AI_MODEL=claude-opus-5
WHATSAPP_AI_EFFORT=low
# How many earlier chat messages are sent to the AI as context
WHATSAPP_AI_HISTORY_MESSAGES=20
# Payment link validity (minimum 16 minutes; Razorpay needs 15+)
WHATSAPP_PAYMENT_LINK_TTL_MINUTES=1440
# Conversation content is deleted automatically after this many days
WHATSAPP_MESSAGE_RETENTION_DAYS=365
WHATSAPP_INBOUND_WORKER_ENABLED=true
WHATSAPP_INBOUND_POLL_INTERVAL_MS=1000
# Public website address used in links sent on WhatsApp (defaults to CLIENT_ORIGIN)
PUBLIC_SITE_URL=
# Leave empty in production; tests point this at a local mock
WHATSAPP_GRAPH_BASE_URL=

# --- Razorpay (WhatsApp question packs) ---
# The assistant sends a Payment Link when free questions run out. Off until all three are set.
# Webhook URL to register in the Razorpay Dashboard: https://<api-domain>/api/webhooks/razorpay
# Events: payment_link.paid, payment_link.expired, payment_link.cancelled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave empty in production; tests point this at a local mock
RAZORPAY_API_BASE_URL=

# --- Online payments for the service catalogue (Razorpay Standard Checkout) ---
# Checkout uses RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET above; webhooks also need RAZORPAY_WEBHOOK_SECRET.
# In the Razorpay Dashboard add these events to the same webhook URL (https://<api-domain>/api/webhooks/razorpay):
#   payment.captured, order.paid, payment.failed, refund.processed, refund.failed
# WhatsApp template (body variables: {{1}} name, {{2}} order reference, {{3}} services) for "payment received"
WHATSAPP_TEMPLATE_ORDER_PAID=order_paid

# --- AI document review ---
# Uses ANTHROPIC_API_KEY. Effort: low | medium | high | xhigh
DOCUMENT_REVIEW_MODEL=claude-opus-5
DOCUMENT_REVIEW_EFFORT=medium
# Reviews per client in a rolling 24 hours (failed reviews don't count)
DOCUMENT_REVIEW_DAILY_LIMIT=3
DOCUMENT_REVIEW_MAX_PAGES=50
# Uploaded PDFs are deleted this many days after the review finishes (kept if a lawyer review is requested)
DOCUMENT_REVIEW_FILE_RETENTION_DAYS=7
DOCUMENT_REVIEW_MAX_ATTEMPTS=3
DOCUMENT_REVIEW_WORKER_ENABLED=true
DOCUMENT_REVIEW_POLL_INTERVAL_MS=2000

# --- Callback requests ---
# A repeat request from the same phone within this many minutes returns the pending one
CALLBACK_DEDUPE_MINUTES=30

# --- Tests only ---
# JSON of feature flags to override, honoured only when NODE_ENV=test. Leave unset everywhere else.
# FEATURE_FLAGS_OVERRIDE={"coupons":false}
