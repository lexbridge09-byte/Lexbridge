{
  "name": "lexbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @lexbridge/api dev\" \"pnpm --filter @lexbridge/web dev\"",
    "dev:api": "pnpm --filter @lexbridge/api dev",
    "dev:web": "pnpm --filter @lexbridge/web dev",
    "build:web": "pnpm --filter @lexbridge/web build",
    "lint:web": "pnpm --filter @lexbridge/web lint"
  },
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "packageManager": "pnpm@11.22.0"
}
